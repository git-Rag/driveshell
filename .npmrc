shamefully-hoist=false
# Persist approval for esbuild's postinstall script (required for Vite).
# esbuild is a well-known, widely-used bundler; its postinstall only downloads
# the correct platform binary. No secrets or sensitive operations.
approve-builds[]=esbuild
# better-sqlite3 postinstall downloads the correct prebuilt native binary.
# It is a well-maintained, widely-used SQLite wrapper; no sensitive operations.
approve-builds[]=better-sqlite3

