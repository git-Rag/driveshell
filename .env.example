# DriveShell — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ---------------------------------------------------------------------------
# Google OAuth credentials (enter in the Setup Wizard UI instead — these env
# vars are only a fallback for headless / testing environments).
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# Server port (default: 3001, auto-increments if busy)
# SERVER_PORT=3001

# Log level: fatal | error | warn | info | debug | trace
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Thumbnail cache
# ---------------------------------------------------------------------------
# Maximum disk space for cached thumbnails, in bytes (default: 1 073 741 824 = 1 GB)
# THUMB_CACHE_MAX_BYTES=1073741824

# ---------------------------------------------------------------------------
# Sync
# ---------------------------------------------------------------------------
# Incremental sync interval in seconds (default: 300 = 5 min)
# SYNC_INTERVAL_SECONDS=300

